<h1>商品一覧</h1>
<table>
  <% @products.each do |p| %>
    <tr>
      <td><%= p.name %></td>
      <td><%= p.price %>円</td>
      <td><%= link_to "削除", product_path(p), data: { turbo_method: :delete, turbo_confirm: "削除しますか？" } %></td>
    </tr>
  <% end %>
</table>
<%= link_to "商品を追加する", new_product_path %>
