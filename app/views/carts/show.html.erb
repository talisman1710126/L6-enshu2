<h1>カート</h1>
<table>
  <tr><th>商品名</th><th>価格</th><th>数量</th><th>小計</th><th></th></tr>
  <% @cart.cart_items.each do |item| %>
    <tr>
      <td><%= item.product.name %></td>
      <td><%= item.product.price %>円</td>
      <td><%= item.qty %></td>
      <td><%= item.product.price * item.qty %>円</td>
      <td><%= link_to "カートから削除", cartitem_path(item), data: { turbo_method: :delete } %></td>
    </tr>
  <% end %>
</table>
<p>合計金額：<%= @cart.total_price %>円</p>
<%= link_to "商品一覧へ戻る", products_path %>
